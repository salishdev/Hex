{
  "name": "hex-app",
  "version": "0.9.0",
  "description": "Release metadata + changelog automation for the Hex macOS app.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "release": "bash scripts/package-release.sh",
    "release:run": "bun run tools/scripts/release.ts",
    "release:prepare": "bun run tools/scripts/prepare-release.ts",
    "test:release": "bun test tools/scripts/prepare-release.test.ts tools/scripts/release.test.ts",
    "changeset": "changeset",
    "changeset:add": "changeset",
    "changeset:add-ai": "bun run tools/scripts/add-changeset.ts",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "sync-changelog": "bun run tools/scripts/sync-changelog.ts",
    "dev": "bash scripts/dev.sh",
    "install:local": "bash scripts/install-local.sh",
    "test:core": "cd HexCore && swift test",
    "project:generate": "bash scripts/generate-project.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
